rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Replace with the User UID of your admin account (Firebase Authentication → Users).
    function isAdmin() { return request.auth != null && request.auth.uid == "PASTE_ADMIN_UID"; }

    match /wishes/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      // Anyone with the link may add ONE well-formed wish, but can never read any back.
      allow create: if request.resource.data.keys().hasOnly(["name","wish","flower","candles","createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.wish is string
        && request.resource.data.wish.size() > 0 && request.resource.data.wish.size() <= 1000
        && request.resource.data.flower in ["lotus","marigold","jasmine"]
        && request.resource.data.candles is int
        && request.resource.data.candles >= 1 && request.resource.data.candles <= 3
        && request.resource.data.createdAt == request.time;
    }
  }
}
